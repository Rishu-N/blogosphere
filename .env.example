# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Required before you can save an AI provider API key in the admin Settings
# view. Any string works — it's hashed down to a proper encryption key.
# Losing/changing this makes any previously-stored API key undecryptable
# (you'd just re-enter it in Settings).
SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Admin login (single owner, no self-serve reset — see /context.md).
# Generate a hash with: npx tsx -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=
# Any long random string; used to sign the admin session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional overrides. Default to ./data and ./content if unset.
# DATA_DIR=./data
# CONTENT_DIR=./content
